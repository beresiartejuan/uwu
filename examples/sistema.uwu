// La biblioteca estándar (por ahora sólo Linux).
// Se importa como en C++ y sus miembros se usan con `::`.
// Las operaciones que pueden fallar devuelven uniones, y el `match`
// exhaustivo te obliga a manejar el error.

import <fs>;
import <path>;
import <env>;
import <proc>;
import <time>;
import <os>;

print("sistema:", os::name(), os::arch(), "| kernel", os::kernel());
print("usuario:", os::user(), "| cpus:", os::cpus());

let mem = os::memory();
let gib = 1024 * 1024 * 1024;
print("memoria disponible:", (mem.available / gib * 10).round() / 10, "GiB de", (mem.total / gib).round());

// Variables de entorno
match env::get("SHELL") {
    { ok: true, value } => print("shell:", path::file_name(value)),
    { ok: false } => print("SHELL no está definida"),
}

// Archivos
let ruta = path::join(env::temp_dir(), "uwu_demo.txt");
match fs::write(ruta, "hola desde uwu\nsegunda línea\n") {
    { ok: true } => print("escrito", ruta),
    { ok: false, error } => print("error al escribir:", error),
}

match fs::read_lines(ruta) {
    { ok: true, lines } => print("líneas:", lines.len(), "→", lines[0]),
    { ok: false, error } => print("error al leer:", error),
}

match fs::stat(ruta) {
    { ok: true, size, permissions } => print("tamaño:", size, "bytes, permisos:", permissions.to_base(8)),
    { ok: false, error } => print(error),
}

fs::remove(ruta);
print("¿existe todavía?", fs::exists(ruta));

// Procesos
match proc::shell("uname -s && echo $$") {
    { ok: true, code, stdout } => print("shell dijo:", stdout.lines().join(" / "), "(código", code.to_string() + ")"),
    { ok: false, error } => print("no se pudo ejecutar:", error),
}

// Tiempo
let ahora = time::now();
let f = time::local_date(ahora);
print("hoy es", f.day.to_string() + "/" + f.month + "/" + f.year, "| UTC:", time::iso(ahora));
